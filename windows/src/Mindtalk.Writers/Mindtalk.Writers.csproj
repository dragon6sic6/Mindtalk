<Project Sdk="Microsoft.NET.Sdk">
  <!-- The writers: Gemma 4 on this PC (llama.cpp through LLamaSharp), and choosing between
       Gemma, Ollama, LM Studio and Windows' own model. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <!-- CPU (avx/avx2/avx512) always; Vulkan for the GPU where there is one. LLamaSharp picks at load. -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan.Windows" Version="0.30.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mindtalk.Core\Mindtalk.Core.csproj" />
  </ItemGroup>
</Project>
