<?xml version="1.0" encoding="utf-8"?>
<!--
  A quiet black-and-white look: white paper, soft grey cards without borders, serif page
  titles, ink controls — black in light mode, white in dark. Every colour has a light and a
  dark value, so it follows the Light / Dark / System choice in Settings. (The Mac app's
  DesignSystem.swift, value for value.)
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Page background. -->
            <SolidColorBrush x:Key="PaperBrush" Color="#FBFBFB" />
            <!-- Cards and grouped rows. -->
            <SolidColorBrush x:Key="CardBrush" Color="#F0F0F0" />
            <!-- Key chips, soft buttons, hover under tab bar rows. -->
            <SolidColorBrush x:Key="ChipBrush" Color="#E5E5E5" />
            <!-- Text fields and the shortcut box. -->
            <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FieldStrokeBrush" Color="#D4D4D4" />
            <!-- The raised, chosen option in a pill picker. -->
            <SolidColorBrush x:Key="PillBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DividerBrush" Color="#E0E0E0" />
            <!-- Secondary text: at least 6:1 contrast on paper and cards. -->
            <SolidColorBrush x:Key="MutedBrush" Color="#5C5C5C" />
            <!-- Deliberately quiet text (days still to come, version number). -->
            <SolidColorBrush x:Key="FaintBrush" Color="#8C8C8C" />
            <!-- Soft buttons and key chips: raised off the card, with an edge. -->
            <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF" />
            <!-- Primary buttons and switches; Mindtalk's accent. -->
            <SolidColorBrush x:Key="InkBrush" Color="#111111" />
            <SolidColorBrush x:Key="AccentBrush" Color="#111111" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#5A5A5A" />
            <SolidColorBrush x:Key="AccentTintBrush" Color="#111111" Opacity="0.12" />
            <!-- Text on ink. -->
            <SolidColorBrush x:Key="OnInkBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SwitchOffBrush" Color="#E3E3E3" />
            <SolidColorBrush x:Key="SwitchKnobBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#000000" Opacity="0.85" />
            <SolidColorBrush x:Key="HoverBrush" Color="#000000" Opacity="0.08" />
            <SolidColorBrush x:Key="OrangeBrush" Color="#FF9500" />
            <SolidColorBrush x:Key="RecordingBrush" Color="#FF3B30" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#000000" Opacity="0.85" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5C5C5C" />
            <Color x:Key="InkColor">#111111</Color>
            <Color x:Key="PaperColor">#FBFBFB</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PaperBrush" Color="#0E0E0E" />
            <SolidColorBrush x:Key="CardBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="ChipBrush" Color="#303030" />
            <SolidColorBrush x:Key="FieldBrush" Color="#171717" />
            <SolidColorBrush x:Key="FieldStrokeBrush" Color="#3C3C3C" />
            <SolidColorBrush x:Key="PillBrush" Color="#585858" />
            <SolidColorBrush x:Key="DividerBrush" Color="#303030" />
            <SolidColorBrush x:Key="MutedBrush" Color="#A9A9A9" />
            <SolidColorBrush x:Key="FaintBrush" Color="#707070" />
            <SolidColorBrush x:Key="ControlBrush" Color="#383838" />
            <SolidColorBrush x:Key="InkBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="AccentBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentTintBrush" Color="#F2F2F2" Opacity="0.12" />
            <SolidColorBrush x:Key="OnInkBrush" Color="#0E0E0E" />
            <SolidColorBrush x:Key="SwitchOffBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="SwitchKnobBrush" Color="#9A9A9A" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#FFFFFF" Opacity="0.85" />
            <SolidColorBrush x:Key="HoverBrush" Color="#FFFFFF" Opacity="0.08" />
            <SolidColorBrush x:Key="OrangeBrush" Color="#FF9F0A" />
            <SolidColorBrush x:Key="RecordingBrush" Color="#FF453A" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" Opacity="0.85" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A9A9A9" />
            <Color x:Key="InkColor">#F2F2F2</Color>
            <Color x:Key="PaperColor">#0E0E0E</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="GoodBrush" Color="#339E5C" />

    <!-- Page titles: large, light serif. (New York on the Mac; Sitka on Windows.) -->
    <FontFamily x:Key="SerifFont">Sitka Display</FontFamily>
    <FontFamily x:Key="SerifTextFont">Sitka Text</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons</FontFamily>
    <x:Double x:Key="CardRadiusValue">16</x:Double>
    <CornerRadius x:Key="CardRadius">16</CornerRadius>
    <CornerRadius x:Key="ControlRadius">10</CornerRadius>
    <CornerRadius x:Key="ChipRadius">7</CornerRadius>

    <!-- ===== Text ===== -->

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- "App", "Sound"… above a card. -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
    </Style>

    <Style x:Key="RowTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="RowDetailStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== Surfaces ===== -->

    <!-- A soft grey card holding rows. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    </Style>

    <!-- Divider inset like the card's content. -->
    <Style x:Key="CardDividerStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{ThemeResource DividerBrush}" />
        <Setter Property="Margin" Value="22,0" />
    </Style>

    <!-- ===== Buttons ===== -->

    <!-- Ink-black primary button ("Done"). Disabled: a quiet grey, clearly not clickable. -->
    <Style x:Key="InkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource InkBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OnInkBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.3" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Soft button ("Change"): a raised control with a clear edge. -->
    <Style x:Key="SoftButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource ControlBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FieldStrokeBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <!-- The soft shadow under the edge: 1 px down. -->
                        <Border CornerRadius="{StaticResource ControlRadius}" Background="#0F000000" Margin="0,1,0,-1" />
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Face.Opacity" Value="0.7" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A borderless button (icons, links, rows): content only, the pointer does the rest. -->
    <Style x:Key="PlainButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="Content" Background="{TemplateBinding Background}"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="Center">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Opacity" Value="0.7" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Mindtalk's switch: an ink track when on — black in light mode, white in dark, with a
      knob in the opposite colour — so on and off are told apart at a glance in both.
    -->
    <Style x:Key="InkSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="11" Background="{ThemeResource SwitchOffBrush}"
                                BorderBrush="{ThemeResource FieldStrokeBrush}" BorderThickness="1" />
                        <Ellipse x:Name="KnobShadow" Width="17" Height="17" HorizontalAlignment="Left" Margin="2.5,3.5,0,1.5"
                                 Fill="#1F000000">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ShadowShift" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Knob" Width="17" Height="17" HorizontalAlignment="Left" Margin="2.5,0,0,0"
                                 Fill="{ThemeResource SwitchKnobBrush}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.25">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.25" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="16" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowShift" Storyboard.TargetProperty="X" To="16" Duration="0" />
                                    </Storyboard>
                                    <VisualState.Setters>
                                        <Setter Target="Track.Background" Value="{ThemeResource InkBrush}" />
                                        <Setter Target="Track.BorderThickness" Value="0" />
                                        <Setter Target="Knob.Fill" Value="{ThemeResource OnInkBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="16" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowShift" Storyboard.TargetProperty="X" To="16" Duration="0" />
                                    </Storyboard>
                                    <VisualState.Setters>
                                        <Setter Target="Track.Background" Value="{ThemeResource InkBrush}" />
                                        <Setter Target="Track.BorderThickness" Value="0" />
                                        <Setter Target="Knob.Fill" Value="{ThemeResource OnInkBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="16" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowShift" Storyboard.TargetProperty="X" To="16" Duration="0" />
                                    </Storyboard>
                                    <VisualState.Setters>
                                        <Setter Target="Track.Background" Value="{ThemeResource InkBrush}" />
                                        <Setter Target="Track.BorderThickness" Value="0" />
                                        <Setter Target="Knob.Fill" Value="{ThemeResource OnInkBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="16" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="ShadowShift" Storyboard.TargetProperty="X" To="16" Duration="0" />
                                    </Storyboard>
                                    <VisualState.Setters>
                                        <Setter Target="Track.Background" Value="{ThemeResource InkBrush}" />
                                        <Setter Target="Track.BorderThickness" Value="0" />
                                        <Setter Target="Knob.Fill" Value="{ThemeResource OnInkBrush}" />
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text fields: white, a clear edge, the control radius. -->
    <Style x:Key="FieldStyle" TargetType="TextBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{ThemeResource FieldBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FieldStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>
</ResourceDictionary>
