<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Mindtalk.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (the window draws its own, over Mica) -->
        <StackPanel x:Name="TitleBar" Orientation="Horizontal" Spacing="8" Padding="14,0" VerticalAlignment="Center">
            <Image Source="Assets/Mindtalk-256.png" Width="16" Height="16" />
            <TextBlock Text="Mindtalk" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="28,12,28,28" Spacing="10" MaxWidth="640">

                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,8">
                    <Image Source="Assets/Mindtalk-256.png" Width="56" Height="56" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mindtalk" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="Tagline" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" />

                <!-- Speech model -->
                <TextBlock x:Name="ModelHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                <StackPanel x:Name="ModelCards" Spacing="6" />

                <!-- Shortcut -->
                <TextBlock x:Name="ShortcutHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HotkeyLabel" />
                                <TextBlock x:Name="HotkeyNote" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="HotkeyButton" Grid.Column="1" MinWidth="150" Click="OnPickHotkey" />
                        </Grid>
                        <RadioButtons x:Name="ModeButtons" SelectionChanged="OnModeChanged" />
                    </StackPanel>
                </Border>

                <!-- Microphone -->
                <TextBlock x:Name="MicrophoneHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                <Border Style="{StaticResource Card}">
                    <ComboBox x:Name="MicrophonePicker" HorizontalAlignment="Stretch" SelectionChanged="OnMicrophoneChanged" />
                </Border>

                <!-- Text -->
                <TextBlock x:Name="TextHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="FillersSwitch" Toggled="OnOptionToggled" />
                        <ToggleSwitch x:Name="CommandsSwitch" Toggled="OnOptionToggled" />
                        <ToggleSwitch x:Name="ClipboardSwitch" Toggled="OnOptionToggled" />
                        <ToggleSwitch x:Name="LoginSwitch" Toggled="OnOptionToggled" />
                    </StackPanel>
                </Border>

                <!-- Try it -->
                <TextBlock x:Name="TryHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                <TextBox x:Name="TryBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" />

                <TextBlock x:Name="Credits" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
