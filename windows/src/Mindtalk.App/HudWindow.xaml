<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Mindtalk.App.HudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A fixed stage; the pill animates inside it, centred at the bottom, with room under it for its shadow. -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid x:Name="ShadowHost" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Height="32" />
        <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                Height="32" CornerRadius="16" Background="#FF121212" BorderBrush="#24FFFFFF" BorderThickness="0.5" />
        <!-- The content sits on top, laid out at its final size at once, while the capsule
             under it springs to fit — as SwiftUI animates a background. -->
        <StackPanel x:Name="Row" Orientation="Horizontal" Spacing="10" Height="32" Margin="0,0,0,10"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" />
    </Grid>
</Window>
