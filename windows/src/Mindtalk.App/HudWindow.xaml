<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Mindtalk.App.HudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="Transparent">
        <StackPanel x:Name="Pill" Orientation="Horizontal" Spacing="10" Padding="16,0"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel x:Name="Bars" Orientation="Horizontal" Spacing="3" Height="22" VerticalAlignment="Center" />
            <ProgressRing x:Name="Spinner" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
            <TextBlock x:Name="Label" VerticalAlignment="Center" FontSize="13" MaxWidth="380" TextWrapping="Wrap" />
            <Button x:Name="CancelButton" Visibility="Collapsed" Padding="8,4" Click="OnCancel">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
            <Button x:Name="FinishButton" Visibility="Collapsed" Padding="8,4" Click="OnFinish"
                    Style="{StaticResource AccentButtonStyle}">
                <FontIcon Glyph="&#xE73E;" FontSize="12" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
