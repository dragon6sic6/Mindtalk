<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Mindtalk.App</RootNamespace>
    <AssemblyName>Mindtalk</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: a plain .exe, no MSIX. The Windows App SDK runtime ships alongside it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Bundles the .NET runtime: nothing to install first. -->
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Mindtalk.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Company>Mindact Solutions AB</Company>
    <Product>Mindtalk</Product>
    <!-- Program.cs is the entry point, so the installer/updater gets a word first. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Mindtalk.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Mindtalk-256.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Acknowledgements.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!-- Draws the tray icon (GDI+). -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <!-- Installer and updates (the Mac uses Sparkle). -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mindtalk.Core\Mindtalk.Core.csproj" />
    <ProjectReference Include="..\Mindtalk.Platform\Mindtalk.Platform.csproj" />
  </ItemGroup>
</Project>
